# Copy to .env and fill in. .env is ignored by git, so keys never get committed.
DEBUG=1
SECRET_KEY=change-me-for-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional LLM (any OpenAI-compatible API). Leave LLM_API_KEY empty to run in offline mode.
# Groq has a free tier: https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Local alternative with Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1  LLM_API_KEY=ollama

# Retrieval: tfidf (default) or embeddings (needs sentence-transformers)
RAG_BACKEND=tfidf
RAG_MIN_SCORE=0.14
